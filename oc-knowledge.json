
<script>
let knowledge = {};

fetch("oc-knowledge.json")
  .then(response => {
    if (!response.ok) throw new Error("File not found");
    return response.json();
  })
  .then(data => {
    knowledge = data.categories;
    console.log("OC Genie is ready!");
  })
  .catch(error => {
    console.error("Knowledge error:", error);
  });

const input = document.getElementById("userInput");
const chatArea = document.getElementById("chatArea");
const conversation = document.getElementById("conversation");

function addMessage(text, type) {
  conversation.classList.add("active");

  const message = document.createElement("div");
  message.className = "message " + type;
  message.textContent = text;

  chatArea.appendChild(message);
  return message;
}

function sendMessage() {
  const question = input.value.trim();
  if (!question) return;

  addMessage(question, "user-message");
  input.value = "";

  const q = question.toLowerCase();
  let category = "";

  if (/crab|seafood|oyster|shrimp/.test(q))
    category = "seafood";
  else if (/breakfast|brunch|pancake/.test(q))
    category = "breakfast";
  else if (/rain|indoor/.test(q))
    category = "rainy_day";
  else if (/date|romantic|anniversary/.test(q))
    category = "date_night";
  else if (/nightlife|club|bar|music|dance/.test(q))
    category = "nightlife";
  else if (/teen|arcade|go.kart/.test(q))
    category = "teens";
  else if (/shop|store|outlet|souvenir/.test(q))
    category = "shopping";
  else if (/free|cheap|budget/.test(q))
    category = "free_and_budget";
  else if (/family|kid|child/.test(q))
    category = "family";
  else if (/late|tonight/.test(q))
    category = "open_late";
  else if (/food|eat|restaurant|dinner|lunch/.test(q))
    category = "food";
  else if (/activity|attraction|fun|boardwalk|beach/.test(q))
    category = "things_to_do";

  if (!category) {
    const all = Object.entries(knowledge);
    const found = all.find(([key, places]) =>
      Array.isArray(places) &&
      places.some(place =>
        place.name.toLowerCase().includes(q)
      )
    );
    if (found) category = found[0];
  }

  const places = knowledge[category];

  if (!places || !places.length) {
    addMessage(
      "I don't have a matching recommendation yet. " +
      "Try asking about seafood, restaurants, " +
      "nightlife, shopping, or family activities. " +
      "If nothing works, check that oc-knowledge.json " +
      "is uploaded correctly.",
      "genie-message"
    );
    return;
  }

  const reply = addMessage(
    "✨ Here are some Ocean City recommendations:",
    "genie-message"
  );

  places.slice(0, 3).forEach(place => {
    const card = document.createElement("div");
    card.className = "result";

    const title = document.createElement("strong");
    title.textContent = place.name;
    card.appendChild(title);

    const details = document.createElement("p");
    details.textContent =
      [place.area, place.price].filter(Boolean).join(" · ");
    card.appendChild(details);

    const tip = document.createElement("p");
    tip.textContent = place.genie_tip || "";
    card.appendChild(tip);

    if (place.address) {
      const address = document.createElement("p");
      address.textContent = "📍 " + place.address;
      card.appendChild(address);
    }

    reply.appendChild(card);
  });
}

function quickQuestion(question) {
  input.value = question;
  sendMessage();
}

document.getElementById("askForm")
  .addEventListener("submit", event => {
    event.preventDefault();
    sendMessage();
  });

document.querySelectorAll("[data-question]")
  .forEach(button => {
    button.addEventListener("click", () => {
      quickQuestion(button.dataset.question);
    });
  });
</script>
